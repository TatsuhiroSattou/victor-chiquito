'use strict';

/* =========================================================
   1. UTILIDADES DE SEGURIDAD
   ========================================================= */

/**
 * Convierte caracteres peligrosos de HTML a su entidad segura.
 * Se usa como defensa en profundidad en los pocos lugares donde
 * construimos un string HTML en vez de usar textContent directo.
 * Mitiga OWASP A03:2021 - Injection (Cross-Site Scripting).
 */
function escapeHTML(texto) {
  var div = document.createElement('div');
  div.textContent = texto;
  return div.innerHTML;
}

/**
 * Limpia espacios en blanco y limita la longitud de un input,
 * para evitar que un visitante guarde cadenas enormes en localStorage.
 */
function limpiarTexto(texto, maxLength) {
  if (typeof texto !== 'string') return '';
  return texto.trim().slice(0, maxLength || 60);
}

/* =========================================================
   2. MODAL DE WRITE-UPS
   ========================================================= */

function initWriteupModals() {
  document.querySelectorAll('[data-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var dialog = document.getElementById(btn.dataset.open);
      if (dialog) dialog.showModal();
    });
  });

  document.querySelectorAll('[data-close]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.closest('dialog').close();
    });
  });

  document.querySelectorAll('dialog.writeup-dialog').forEach(function (dialog) {
    dialog.addEventListener('click', function (event) {
      var rect = dialog.getBoundingClientRect();
      var dentroDelContenido =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!dentroDelContenido) dialog.close();
    });
  });
}

/* =========================================================
   3. MODO CLARO / OSCURO
   ========================================================= */

var THEME_KEY = 'portafolio_theme';

function aplicarTema(tema) {
  var body = document.body;
  var boton = document.getElementById('theme-toggle');

  // Estructura de control: condicional según el tema activo
  if (tema === 'light') {
    body.classList.add('light-mode');
    if (boton) {
      boton.textContent = '☀ Modo oscuro';
      boton.setAttribute('aria-pressed', 'true');
    }
  } else {
    body.classList.remove('light-mode');
    if (boton) {
      boton.textContent = '☾ Modo claro';
      boton.setAttribute('aria-pressed', 'false');
    }
  }
}

function alternarTema() {
  var temaActual = document.body.classList.contains('light-mode') ? 'light' : 'dark';
  var nuevoTema = temaActual === 'light' ? 'dark' : 'light';

  aplicarTema(nuevoTema);

  // Persistencia con localStorage: se recupera y se usa en cada carga (initTheme)
  localStorage.setItem(THEME_KEY, nuevoTema);
}

function initTheme() {
  var temaGuardado = localStorage.getItem(THEME_KEY);

  if (temaGuardado === 'light' || temaGuardado === 'dark') {
    aplicarTema(temaGuardado);
  } else {
    aplicarTema('dark'); // valor por defecto del sitio
  }

  var boton = document.getElementById('theme-toggle');
  if (boton) {
    boton.addEventListener('click', alternarTema); // evento #1: click
  }
}

/* =========================================================
   4. BANNER DE BIENVENIDA (visitante recurrente)
   ========================================================= */

var VISITOR_NAME_KEY = 'portafolio_visitor_name';

function mostrarBannerBienvenida() {
  var nombreGuardado = localStorage.getItem(VISITOR_NAME_KEY);
  var banner = document.getElementById('welcome-banner');

  if (!banner) return;

  // Estructura de control: solo mostramos el banner si hay un nombre guardado
  if (nombreGuardado) {
    // Manipulación del DOM #1: usamos textContent (nunca innerHTML) porque
    // "nombreGuardado" viene de un input del usuario — así se evita un XSS
    // almacenado vía localStorage (OWASP A03:2021 - Injection).
    banner.textContent = 'Bienvenido de nuevo, ' + nombreGuardado + ' 👋 gracias por escribirme antes.';
    banner.hidden = false;
  } else {
    banner.hidden = true;
  }
}

/* =========================================================
   5. CONTADOR DE VISITAS SIMULADO
   ========================================================= */

var VISIT_COUNT_KEY = 'portafolio_visit_count';

function actualizarContadorVisitas() {
  var contadorActual = parseInt(localStorage.getItem(VISIT_COUNT_KEY), 10);

  // Estructura de control: si no hay valor previo o no es un número válido, arrancamos en 0
  if (isNaN(contadorActual)) {
    contadorActual = 0;
  }

  contadorActual += 1;
  localStorage.setItem(VISIT_COUNT_KEY, String(contadorActual));

  var elementoContador = document.getElementById('visit-counter');
  if (elementoContador) {
    // Manipulación del DOM #2: número generado por nosotros mismos (no es
    // input de usuario), pero igual usamos textContent por consistencia.
    elementoContador.textContent = 'Visitas simuladas en este navegador: ' + contadorActual;
  }
}

/* =========================================================
   6. VALIDACIÓN DEL FORMULARIO DE CONTACTO
   ========================================================= */

function mostrarMensajeFormulario(texto, tipo) {
  var contenedor = document.getElementById('form-message');
  if (!contenedor) return;

  contenedor.textContent = texto; // textContent: nunca se interpreta como HTML
  contenedor.className = 'form-message form-message--' + tipo; // 'success' | 'error'
}

function manejarEnvioFormulario(event) {
  event.preventDefault(); // el formulario no envía datos a ningún servidor real

  var inputNombre = document.getElementById('nombre');
  var inputEmail = document.getElementById('email');
  var inputMensaje = document.getElementById('mensaje');

  var nombre = limpiarTexto(inputNombre.value, 60);
  var email = inputEmail.value.trim();
  var mensaje = limpiarTexto(inputMensaje.value, 500);

  // Estructura de control: validación básica pedida por la actividad.
  // IMPORTANTE (AppSec): esta validación es solo de UX. En un sitio con
  // backend real, TODA validación debe repetirse en el servidor — nunca se
  // debe confiar únicamente en JavaScript del lado del cliente, porque
  // cualquier persona puede desactivarlo o manipular la petición directamente
  // (OWASP A04:2021 - Insecure Design / falta de validación server-side).
  if (nombre === '' || email === '' || mensaje === '') {
    mostrarMensajeFormulario('Por favor completa nombre, correo y mensaje antes de enviar.', 'error');
    return;
  }

  // Validación simple de formato de correo
  var pareceEmailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  if (!pareceEmailValido) {
    mostrarMensajeFormulario('Ingresa un correo electrónico válido.', 'error');
    return;
  }

  // Guardamos el nombre para el banner de bienvenida (localStorage)
  localStorage.setItem(VISITOR_NAME_KEY, nombre);
  mostrarBannerBienvenida();

  mostrarMensajeFormulario('¡Gracias, ' + nombre + '! Tu mensaje quedó registrado (demo, sin backend real).', 'success');

  document.getElementById('contacto-form').reset();
}

function initFormularioContacto() {
  var formulario = document.getElementById('contacto-form');
  if (formulario) {
    formulario.addEventListener('submit', manejarEnvioFormulario); // evento #2: submit
  }
}

/* =========================================================
   7. BOTÓN "VOLVER AL INICIO"
   ========================================================= */

function initBackToTop() {
  var boton = document.getElementById('back-to-top');
  if (!boton) return;

  window.addEventListener('scroll', function () {
    // Estructura de control: mostramos el botón solo después de bajar un poco
    if (window.scrollY > 400) {
      boton.hidden = false;
    } else {
      boton.hidden = true;
    }
  });

  boton.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
}

